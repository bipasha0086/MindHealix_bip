{
  "manifest_version": 3,
  "name": "MindHealix YouTube Wellness Guard",
  "version": "1.0.0",
  "description": "Analyzes YouTube content for depression/anxiety risk signals and suggests healthier alternatives.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MindHealix Guard"
  },
  "options_page": "options.html"
}
