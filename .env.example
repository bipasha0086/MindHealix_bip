# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development

# Secret Keys (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Database Configuration
MONGO_URI=mongodb://localhost:27017/mental_health_db

# Server Configuration
PORT=5000

# CORS Configuration
FRONTEND_URL=http://localhost:3000
# Optional comma-separated origins (recommended when using YouTube extension)
# Example:
# CORS_ORIGINS=http://localhost:3000,https://www.youtube.com,https://youtube.com
CORS_ORIGINS=http://localhost:3000,https://www.youtube.com

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRES=3600

# Gemini Chatbot Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# YouTube Wellness Semantic Analysis (off | auto | groq | gemini)
YT_SEMANTIC_PROVIDER=off
YT_GROQ_MODEL=llama-3.1-8b-instant
YT_GEMINI_MODEL=gemini-2.0-flash

# Twilio Alerting (WhatsApp/SMS/Call)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_ALERT_TO=919999999999
TWILIO_DEFAULT_COUNTRY_CODE=+91
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ALERT_CHANNELS=whatsapp
TWILIO_SMS_FROM=
TWILIO_CALL_FROM=
TWILIO_CALL_ENABLED=false

# Chatbot Hardening (optional)
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_MAX_REQUESTS=12
CHAT_CACHE_TTL_SECONDS=45
CHAT_CACHE_MAX_ITEMS=300
